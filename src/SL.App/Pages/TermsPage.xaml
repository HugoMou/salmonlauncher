<Page
    x:Class="SL.App.Pages.TermsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Margin="36,28,36,36" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="用户协议与免责声明"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />
            <Grid ColumnSpacing="8" Margin="0,-12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource Brush.AccentSoft}"
                        CornerRadius="4"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="VersionLineText"
                               FontSize="11"
                               Foreground="{ThemeResource Brush.Accent}" />
                </Border>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Brush.FgDim}"
                           TextWrapping="Wrap"
                           Text="最近更新 2026 年 10 月 · 使用本软件即表示你已阅读并接受以下全部条款。" />
            </Grid>

            <!-- Key points at a glance -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="要点速览" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}"
                               Text="· 本软件是免费的第三方工具,与 Mojang Studios、Microsoft 无隶属或授权关系。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}"
                               Text="· 不含统计、埋点与广告;设置、账户、日志与存档只保存在本机。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}"
                               Text="· 游戏文件从官方源与公开镜像下载,本软件不内置、不分发游戏本体。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}"
                               Text="· 软件按「现状」提供,重要操作前请自行备份存档与实例。" />
                </StackPanel>
            </Border>

            <!-- Consent status -->
            <Border Background="{ThemeResource Brush.AccentSoft}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;"
                              FontSize="18"
                              Foreground="{ThemeResource Brush.Accent}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="AcceptStateText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <Button x:Name="AcceptButton"
                            Grid.Column="2"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="同意并继续"
                            Click="OnAccept"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="一、总则与适用范围" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. SalmonLauncher(以下简称「本软件」)是一款用于管理、安装与启动 Minecraft 的第三方桌面工具。本协议是你与本软件作者之间关于使用本软件的约定。若你不同意其中任何条款,请停止使用并删除本软件。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 本协议适用于启动器本体及其提供的全部功能,包括版本安装、实例管理、内容下载、账户管理、联机、主题与崩溃诊断。游戏本体不在本协议范围内,其使用须遵守 Mojang Studios 的最终用户许可协议。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 本协议自你首次安装或首次启动本软件之日起生效;当前条款版本 1.0,最近更新于 2026 年 10 月。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="二、账号与凭据" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 微软账户登录由微软官方 OAuth 页面完成,本软件不会接触也不保存你的密码,仅在本地保存登录后获得的访问令牌与刷新令牌。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 所有账户信息与令牌都保存在本机数据目录中,不会上传到任何服务器。你可以随时在「外观与设置」中删除账户,或直接删除数据目录。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 离线账户仅用于本地游戏,不具备正版身份,无法进入开启了正版验证的服务器。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 令牌仅用于向 Mojang / Microsoft 请求游戏档案、下载权限与联机身份,不会用于其它用途,也不会被本软件转发给第三方。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="三、游戏文件与数据" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 游戏本体、运行库与资源文件均从 Mojang 官方源或其公开镜像下载,本软件不分发、不修改、不内置任何 Minecraft 游戏文件。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 模组、光影与资源包来自 Modrinth 等公开平台,其版权与许可归各自作者所有,请遵守对应项目的授权条款。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 实例、存档、日志与皮肤都保存在本机数据目录,卸载本软件不会自动删除,请自行备份。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 数据目录默认位于 %APPDATA%\SalmonLauncher,可在「关于」页一键打开;更换电脑时复制整个目录即可迁移设置与实例。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="四、使用规范" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 你应当拥有你所使用的 Minecraft 账户,并通过正规渠道获取游戏。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 不得利用本软件绕过正版验证、发布破解内容、传播恶意文件,或从事任何违反当地法律法规的行为。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 联机功能通过第三方虚拟局域网组件建立连接,请勿用于未经授权的入侵或流量攻击。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 通过本软件下载的模组、光影与资源包来自第三方,其内容与安全性由你自行判断;作者不对第三方内容造成的损失负责。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="五、第三方服务" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本软件会访问 Mojang 版本元数据、BMCLAPI 镜像、Modrinth 接口、GitHub 与 Eclipse Temurin 等第三方服务。这些服务由其运营方独立提供,并适用各自的条款与隐私政策,本软件不对其可用性与内容承担责任。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 第三方服务的域名、接口与返回内容可能随时调整,可能导致安装或更新暂时失败;本软件会尽力适配,但不作保证。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 因第三方服务中断、限流或校验失败导致的下载失败,你可以稍后重试,或在「外观与设置」中切换下载源。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="六、隐私与本地数据" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本软件不含任何统计、埋点或广告组件,不会收集你的设备信息、游戏行为或个人信息,也不会向你推送商业内容。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 设置、账户令牌、日志、实例与存档都只保存在本机数据目录,不会上传到作者或任何第三方服务器;本软件不提供云同步。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 日志文件仅在你主动分享时才会被读取,内容可能包含版本号、Java 路径与游戏输出;分享前请自行检查是否含有敏感信息。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 使用联机功能时,房间信息仅在你与好友之间直接传输,不经过作者的中转服务器;请勿在其中填写真实姓名、住址等个人信息。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="5. 皮肤与材质只在本机缓存,用于界面与游戏显示,不用于身份识别、追踪或用户画像。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="七、未成年人使用" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 未满 18 周岁的用户应在监护人指导下使用本软件,并由监护人阅读并同意本协议。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 本软件不含内购、广告或社交内容,但仍建议监护人关注孩子的游戏时间与下载内容。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="八、开源组件与许可" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本软件基于 .NET 与 Windows App SDK(WinUI 3)等开源框架构建,相关组件遵循其各自的开源许可。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 启动器内置的壁纸与图标由本软件自行绘制,可随软件一起分发;Minecraft 的名称、纹理与相关资源归 Mojang Studios 所有。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 本软件以 GNU General Public License(GPL)第 3 版或其更新版本许可发布;你可以自由运行、研究、修改与再分发本软件(包括收费分发),但须遵守 GPL 条款。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 再分发时须保留版权声明与许可声明,并向接收者提供完整对应的源代码;许可证全文见项目根目录的 LICENSE 文件与 https://www.gnu.org/licenses/gpl-3.0.html。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="5. Copyright (C) 2026 Hugo Mou. SalmonLauncher 及其源代码的版权归作者所有,保留所有权利。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="九、免责声明" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本软件为第三方免费工具,与 Mojang Studios、Microsoft 无任何隶属或授权关系,Minecraft 是 Mojang Studios 的商标。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 软件按「现状」提供,作者不对下载失败、存档损坏、账户异常或任何间接损失作出担保与赔偿;请在重要操作前自行备份存档。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 本软件不承担因第三方服务中断、网络波动、系统更新或磁盘故障导致的功能异常与数据损失。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="4. 因你违反本协议或当地法律法规而产生的任何后果,由你自行承担。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="十、协议变更与终止" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 本协议可能随功能演进更新,更新后的条款随新版本一同发布,你可以在本页随时回顾最新版本。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 条款更新后你若继续使用本软件,视为接受更新内容;若不接受,请停止使用并删除本软件。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="3. 你可以随时删除数据目录来停止使用本软件,本协议随之终止;已下载的游戏与实例请先行备份。" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="十一、联系方式与反馈" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="1. 遇到问题、发现漏洞或对本协议有疑问,可通过你获取本软件的项目仓库 Issue 或发布渠道反馈。" />
                        <TextBlock Style="{ThemeResource Style.TermsBody}"
                                   Text="2. 反馈时请附上版本号、系统版本与相关日志尾部,以便更快定位问题;请勿在公开反馈中粘贴账户令牌。" />
                    </StackPanel>

                    <TextBlock Style="{ThemeResource Style.TermsBody}"
                               Foreground="{ThemeResource Brush.FgFaint}"
                               Text="Copyright (C) 2026 Hugo Mou · 本项目以 GNU GPL v3 或更新版本发布;完整许可证见项目根目录 LICENSE,源代码见项目仓库。" />

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>