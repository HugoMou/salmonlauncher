<Page
    x:Class="SL.App.Pages.InstanceOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Margin="36,28,36,32" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="实例概览"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <ComboBox x:Name="InstanceBox"
                          Grid.Column="1"
                          MinWidth="220"
                          VerticalAlignment="Center"
                          SelectionChanged="OnInstanceChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Id}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource Brush.AccentSoft}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="{ThemeResource Brush.Accent}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="InstanceId"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock x:Name="InstalledText"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource Brush.AccentSoft}" CornerRadius="10" Padding="14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="模组" FontSize="11" Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="ModCount" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource Brush.AccentSoft}" CornerRadius="10" Padding="14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="存档" FontSize="11" Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="SaveCount" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource Brush.AccentSoft}" CornerRadius="10" Padding="14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="占用" FontSize="11" Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="SizeText" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{ThemeResource AccentButtonStyle}" Click="OnLaunch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="启动该实例" />
                            </StackPanel>
                        </Button>
                        <Button Content="打开目录" Click="OnOpenDir" />
                        <Button Content="备份存档" Click="OnBackupSaves" />
                        <Button Content="复制实例" Click="OnDuplicateInstance" />
                        <Button Content="检查实例" Click="OnCheckHealth" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OnOpenMods">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="模组管理" FontWeight="SemiBold" />
                        <TextBlock Text="启用 / 停用 / 删除 / 导入"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OnOpenLogs">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="实例日志" FontWeight="SemiBold" />
                        <TextBlock Text="latest.log 尾部查看"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OnOpenCfg">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Text="实例设置" FontWeight="SemiBold" />
                        <TextBlock Text="内存、窗口与 JVM 参数"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>