<Page
    x:Class="SL.App.Pages.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:SL.App.Pages">

    <ScrollViewer x:Name="PageScroll"
                  Padding="36,28,36,32"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel x:Name="ContentRoot" Spacing="14" HorizontalAlignment="Left">

            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="联机"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <Button x:Name="ElevateButton"
                        Grid.Column="1"
                        Content="以管理员身份重启"
                        Click="OnElevate"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
            </Grid>

            <!-- Admin requirement notice -->
            <Border x:Name="AdminNotice"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="联机需要一个虚拟网卡"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="AdminNoticeText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
            </Border>

            <!-- Mode switch -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10">
                <Border Style="{StaticResource Style.SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton x:Name="ModeCreate"
                                     GroupName="LinkMode"
                                     Content="创建房间"
                                     Style="{StaticResource Style.Segment}"
                                     Checked="OnModeChecked" />
                        <RadioButton x:Name="ModeJoin"
                                     GroupName="LinkMode"
                                     Content="加入房间"
                                     Style="{StaticResource Style.Segment}"
                                     Checked="OnModeChecked" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ===================== Create a room ===================== -->
            <StackPanel x:Name="CreatePanel" Spacing="14">

                <Border Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                            <TextBlock Grid.Column="1"
                                       Text="先在游戏里「对局域网开放」,下面会列出本机开放的世界;选中一个再创建房间,房间码发给好友即可。"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="本机已开放的世界"
                                           FontSize="12"
                                           Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="LanEmptyText"
                                           Text="还没有检测到。请在游戏里「对局域网开放」,或手动填写端口。"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                                <ListView x:Name="LanWorldList"
                                          SelectionMode="Single"
                                          MaxHeight="150"
                                          IsItemClickEnabled="True"
                                          ItemClick="OnLanWorldClick"
                                          Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="pages:LanWorldRow">
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                                <TextBlock Text="{x:Bind Motd}"
                                                           FontSize="12.5"
                                                           Foreground="{ThemeResource Brush.Fg}" />
                                                <TextBlock Text="{x:Bind Address}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource Brush.FgFaint}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="重新扫描"
                                    Click="OnRescanLan"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="GamePortBox"
                                       Header="游戏端口"
                                       Minimum="1"
                                       Maximum="65535"
                                       SmallChange="1"
                                       Value="25565"
                                       SpinButtonPlacementMode="Compact"
                                       Width="130" />
                            <TextBox x:Name="RoomNameBox"
                                     Grid.Column="1"
                                     Header="房间名"
                                     PlaceholderText="例如:周末生存"
                                     MaxLength="48" />
                            <TextBox x:Name="NoticeBox"
                                     Grid.Column="2"
                                     Header="公告(可选)"
                                     PlaceholderText="例如:禁止破坏建筑"
                                     MaxLength="200" />
                            <NumberBox x:Name="MaxPlayersBox"
                                       Grid.Column="3"
                                       Header="人数上限"
                                       Minimum="0"
                                       Maximum="100"
                                       SmallChange="1"
                                       Value="0"
                                       SpinButtonPlacementMode="Compact"
                                       Width="130" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="HostButton"
                                    Content="创建房间"
                                    Click="OnHost"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="StopHostButton"
                                    Content="结束房间"
                                    Click="OnStopHost"
                                    Visibility="Collapsed" />
                            <ProgressBar x:Name="HostProgress"
                                         Width="220"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Room code card -->
                <Border x:Name="RoomCard"
                        Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="房间码"
                                           FontSize="12"
                                           Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="HostCodeText"
                                           FontFamily="Consolas"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource Brush.Fg}" />
                                <TextBlock Text="好友在「加入房间」里粘贴这串码即可;一串码对应一条专属的虚拟局域网,别人猜不到。"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="复制房间码"
                                    Click="OnCopyCode"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="游戏内连接地址"
                                           FontSize="12"
                                           Foreground="{ThemeResource Brush.FgDim}" />
                                <TextBlock x:Name="HostAddressText"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource Brush.Fg}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="复制地址"
                                    Click="OnCopyAddress"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="房间成员"
                                       FontSize="12"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                            <ListView x:Name="HostPlayersList" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:LinkPlayerRow">
                                        <Grid ColumnSpacing="10" Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource Brush.FgDim}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource Brush.Fg}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Tag}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource Brush.FgFaint}" />
                                            <Button Grid.Column="3"
                                                    Content="移出"
                                                    FontSize="11"
                                                    Visibility="{x:Bind CanKick}"
                                                    Command="{x:Bind KickCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== Join a room ===================== -->
            <StackPanel x:Name="JoinPanel" Spacing="14" Visibility="Collapsed">

                <Border Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FA;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                            <TextBlock Grid.Column="1"
                                       Text="粘贴好友发来的房间码,连上后点「启动游戏并进入」即可直接进入对方的局域网世界。"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodeBox"
                                     Header="房间码"
                                     FontFamily="Consolas"
                                     PlaceholderText="U/XXXX-XXXX-XXXX-XXXX" />
                            <Button x:Name="JoinButton"
                                    Grid.Column="1"
                                    Content="加入"
                                    Click="OnJoin"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom" />
                            <Button x:Name="LeaveButton"
                                    Grid.Column="2"
                                    Content="断开"
                                    Click="OnStopHost"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                        </Grid>

                        <ProgressBar x:Name="JoinProgress"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border x:Name="JoinCard"
                        Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="JoinRoomNameText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock x:Name="JoinNoticeText"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="LaunchButton"
                                    Content="启动游戏并进入"
                                    Click="OnLaunchGame"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ModsButton"
                                    Content="同步房主模组"
                                    Click="OnSyncMods"
                                    Visibility="Collapsed" />
                            <TextBlock x:Name="JoinAddressText"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource Brush.FgFaint}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="房间成员"
                                       FontSize="12"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                            <ListView x:Name="JoinPlayersList" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:LinkPlayerRow">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                                            <FontIcon Glyph="{x:Bind Glyph}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource Brush.FgDim}" />
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="12.5"
                                                       Foreground="{ThemeResource Brush.Fg}" />
                                            <TextBlock Text="{x:Bind Tag}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource Brush.FgFaint}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== Log ===================== -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="运行日志"
                               FontSize="12"
                               Foreground="{ThemeResource Brush.FgDim}" />
                    <ScrollViewer x:Name="LogScroll" Height="150" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="LogList" SelectionMode="None" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
