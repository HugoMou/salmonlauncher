<Page
    x:Class="SL.App.Pages.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="PageScroll"
                  Padding="36,28,36,32"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel x:Name="ContentRoot" Spacing="14" HorizontalAlignment="Left">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="联机"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                    <TextBlock x:Name="DetailText"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource Brush.FgFaint}" />
                </StackPanel>
                <Button x:Name="LaunchButton"
                        Grid.Column="1"
                        Content="打开 Campfire"
                        Click="OnLaunchCampfire"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{ThemeResource Brush.Accent}" />
                        <TextBlock Grid.Column="1"
                                   Text="联机由内置的 Campfire 负责：它接管游戏、自动对局域网开放并生成邀请码，支持跨网联机与联机大厅。启动器只负责把它带在身边并一键启动。"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="内置版本" FontSize="12" Foreground="{ThemeResource Brush.FgDim}" />
                        <TextBlock x:Name="VersionText" FontSize="12.5" IsTextSelectionEnabled="True"
                                   FontFamily="Consolas" Foreground="{ThemeResource Brush.Fg}" />
                        <TextBlock x:Name="PathText" FontSize="11.5" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="复制程序路径" Click="OnCopyPath" />
                        <Button Content="打开所在文件夹" Click="OnOpenFolder" />
                        <Button Content="联机说明" Click="OnShowHelp" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="MissingCard"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="没有找到内置的 Campfire"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="MissingText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于许可" FontSize="12" Foreground="{ThemeResource Brush.FgDim}" />
                    <TextBlock Text="Campfire 以 GPL-3.0 发布，本启动器按该协议随安装包分发其未修改的发行版，并附带许可证与源码获取方式；它自带更新，更新后仍按同一协议分发。"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgFaint}" />
                    <TextBlock x:Name="LicenseText" FontSize="11.5" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource Brush.FgFaint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
