<Page
    x:Class="SL.App.Pages.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <Grid Grid.Row="0" Margin="36,28,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="联机"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           Foreground="{ThemeResource Brush.Fg}" />
                <TextBlock Text="用 Campfire 把世界分享给好友，只需一步。"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border x:Name="StatusIndicator"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        Background="{ThemeResource Brush.FgFaint}" />
                <TextBlock x:Name="StatusBadgeText"
                           FontSize="12"
                           Foreground="{ThemeResource Brush.FgDim}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 内容 ==================== -->
        <ScrollViewer Grid.Row="1"
                      Padding="36,16,36,28"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="14" HorizontalAlignment="Stretch">

                <!-- 主操作：一句话状态 + 一个主按钮 -->
                <Border Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="56"
                                Height="56"
                                CornerRadius="14"
                                VerticalAlignment="Center"
                                Background="{ThemeResource Brush.AccentSoft}">
                            <FontIcon Glyph="&#xE968;"
                                      FontSize="24"
                                      Foreground="{ThemeResource Brush.Accent}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="HeadlineText"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock x:Name="StatusText"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    MinWidth="170">
                            <Button x:Name="LaunchButton"
                                    Content="打开 Campfire"
                                    Click="OnLaunchCampfire"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="44" />
                            <Button x:Name="StopButton"
                                    Content="关闭 Campfire"
                                    Click="OnStopCampfire"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="34"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 更新（合并了版本与检查） -->
                <Border Background="{ThemeResource Brush.Card}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="版本"
                                           FontSize="12"
                                           Foreground="{ThemeResource Brush.FgDim}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="VersionText"
                                               FontSize="14"
                                               FontFamily="Consolas"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock x:Name="LatestHintText"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="CheckButton"
                                        Content="检查更新"
                                        Click="OnCheckUpdates"
                                        Height="34"
                                        FontSize="12" />
                                <Button x:Name="UpdateButton"
                                        Click="OnUpdateCampfire"
                                        Height="34"
                                        FontSize="12"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed" />
                                <Button x:Name="CancelUpdateButton"
                                        Content="取消"
                                        Click="OnCancelUpdate"
                                        Height="34"
                                        FontSize="12"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="UpdateProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed" />

                        <TextBlock x:Name="UpdateStatusText"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgFaint}" />
                    </StackPanel>
                </Border>

                <!-- 使用说明 + 程序信息 -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="怎么用"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock Text="1. 点上面的按钮打开 Campfire。&#x0a;2. 在 Campfire 里进入世界，它会自动把世界开放到局域网。&#x0a;3. 邀请码发给好友，好友粘贴后即可加入。"
                                       FontSize="12"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                            <HyperlinkButton Content="查看完整说明"
                                             Click="OnShowHelp"
                                             FontSize="12"
                                             Padding="0"
                                             Margin="0,-2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="程序信息"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="位置"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                                <TextBlock x:Name="PathText"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Text="许可证：GPL-3.0 · 源码：https://github.com/Xocio/Campfire"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource Brush.FgFaint}"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton Content="打开文件夹"
                                                 Click="OnOpenFolder"
                                                 FontSize="12"
                                                 Padding="0" />
                                <HyperlinkButton Content="复制路径"
                                                 Click="OnCopyPath"
                                                 FontSize="12"
                                                 Padding="0" />
                                <HyperlinkButton Content="发布页"
                                                 NavigateUri="https://github.com/Xocio/Campfire/releases"
                                                 FontSize="12"
                                                 Padding="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Campfire 以 GPL-3.0 发布。启动器随安装包分发其未修改的官方发行版；更新优先经镜像加速，并用官方发布页给出的 SHA-256 校验，更新后的文件仍保持未修改。"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="4,0"
                           Foreground="{ThemeResource Brush.FgFaint}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
