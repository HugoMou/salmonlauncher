<Page
    x:Class="SL.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  Padding="30,20,30,24">

        <Grid x:Name="Root"
              MaxWidth="1120"
              HorizontalAlignment="Center"
              RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="启动面板"
                               FontSize="{StaticResource PageTitleSize}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Text="选好实例与账户，一键进入世界。"
                               Style="{ThemeResource Style.PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Border Style="{ThemeResource Style.Badge}">
                        <TextBlock x:Name="VersionBadgeText"
                                   Text="v0.0.0"
                                   FontSize="11"
                                   Foreground="{ThemeResource Brush.Accent}" />
                    </Border>
                    <Ellipse Width="7" Height="7"
                             Fill="{ThemeResource Brush.Accent}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="{Binding StatusText}"
                               FontSize="12.5"
                               Foreground="{ThemeResource Brush.FgDim}"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 主操作卡：左侧启动，右侧账户 -->
            <Border Grid.Row="1"
                    Style="{ThemeResource Style.Card}"
                    Padding="26,22">
                <Grid ColumnSpacing="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- 启动区 -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="游戏版本"
                                   Style="{ThemeResource Style.SectionTitle}" />

                        <ComboBox x:Name="InstanceBox"
                                  ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                  SelectionChanged="OnInstanceSelectionChanged"
                                  PlaceholderText="尚无实例 · 先去下载"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="9">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Padding="0,1">
                                        <TextBlock Text="{Binding Id}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource Brush.FgDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button x:Name="LaunchButton"
                                Command="{Binding LaunchCommand}"
                                Style="{ThemeResource Style.LaunchCard}"
                                Height="66"
                                Margin="0,4,0,0">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE768;"
                                          FontSize="17"
                                          Foreground="{ThemeResource Brush.AccentFg}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                    <TextBlock Text="启动 Minecraft"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource Brush.AccentFg}" />
                                    <TextBlock Text="{Binding LaunchHint}"
                                               FontSize="10.5"
                                               Opacity="0.8"
                                               Foreground="{ThemeResource Brush.AccentFg}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Foreground="{ThemeResource Brush.Accent}"
                                     Background="{ThemeResource Brush.Border}"
                                     Visibility="{Binding ProgressVisibility}"
                                     Margin="0,2,0,0" />

                        <Grid ColumnSpacing="8" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="11"
                                      Foreground="{ThemeResource Brush.FgFaint}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InstanceSummary}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- 竖分隔线 -->
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{ThemeResource Brush.Border}"
                               VerticalAlignment="Stretch" />

                    <!-- 账户区 -->
                    <StackPanel Grid.Column="2" Spacing="10">
                        <TextBlock Text="账户"
                                   Style="{ThemeResource Style.SectionTitle}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="23"
                                    Background="{ThemeResource Brush.AccentSoft}">
                                <FontIcon Glyph="{Binding AccountGlyph}"
                                          FontSize="19"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding AccountName}"
                                           FontSize="15.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AccountDetail}"
                                           FontSize="10.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           MaxLines="2" />
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{Binding OpenAccountCommand}"
                                Style="{ThemeResource Style.Ghost}"
                                Foreground="{ThemeResource Brush.Accent}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76C;"
                                          FontSize="11"
                                          Foreground="{ThemeResource Brush.Accent}" />
                                <TextBlock Text="账户管理"
                                           FontSize="12"
                                           Foreground="{ThemeResource Brush.Accent}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 快捷入口 -->
            <StackPanel Grid.Row="2" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="3"
                            Height="13"
                            CornerRadius="2"
                            Background="{ThemeResource Brush.Accent}" />
                    <TextBlock Text="快捷入口"
                               Style="{ThemeResource Style.SectionTitle}" />
                </StackPanel>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding OpenDownloadCommand}"
                            Style="{ThemeResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="15"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="下载游戏" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                                <TextBlock Text="安装新版本与补全文件" FontSize="10.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding OpenMultiplayerCommand}"
                            Style="{ThemeResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE709;" FontSize="15"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="联机" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                                <TextBlock Text="与好友一起开玩" FontSize="10.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding OpenDiagCommand}"
                            Style="{ThemeResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="崩溃诊断" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                                <TextBlock Text="崩溃时自动分析日志" FontSize="10.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="3"
                            Command="{Binding OpenLogsCommand}"
                            Style="{ThemeResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="应用日志" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}" />
                                <TextBlock Text="查看启动器运行记录" FontSize="10.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 上手指南 -->
            <Border Grid.Row="3"
                    Style="{ThemeResource Style.Card}"
                    Padding="20,16">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="20" Height="20" CornerRadius="10"
                                    Background="{ThemeResource Brush.AccentSoft}">
                                <TextBlock Text="1" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="安装版本" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="前往「游戏版本」安装 Minecraft 版本。"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource Brush.FgDim}"
                                   TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="20" Height="20" CornerRadius="10"
                                    Background="{ThemeResource Brush.AccentSoft}">
                                <TextBlock Text="2" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="设置账户" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="登录账户，或使用离线账户。"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource Brush.FgDim}"
                                   TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="20" Height="20" CornerRadius="10"
                                    Background="{ThemeResource Brush.AccentSoft}">
                                <TextBlock Text="3" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="启动游戏" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="点击启动按钮进入游戏。"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource Brush.FgDim}"
                                   TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>