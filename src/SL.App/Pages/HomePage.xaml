<Page
    x:Class="SL.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <Grid x:Name="Root"
              Margin="32,20,32,28"
              MaxWidth="1120"
              HorizontalAlignment="Left"
              RowSpacing="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title band + live status -->
            <Border Grid.Row="0"
                    CornerRadius="18"
                    Padding="32,26"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource Brush.Border}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{ThemeResource AccentBandStart}" />
                        <GradientStop Offset="1" Color="{ThemeResource AccentBandEnd}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="GreetingText"
                                       Text="启动面板"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <Border Background="{ThemeResource Brush.Accent}"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.AccentFg}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="选好实例与账户，一键进入世界。"
                                   FontSize="13"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{ThemeResource Brush.Success}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource Brush.FgDim}"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero: instance + launch on the left, account on the right -->
            <Grid Grid.Row="1">
                <Border CornerRadius="22"
                        Background="{ThemeResource Shadow.Hero}"
                        Margin="10,14,10,0"
                        IsHitTestVisible="False" />
                <Border Style="{StaticResource Style.HeroCard}"
                        Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Padding="28,24" Spacing="14">
                        <TextBlock Text="游戏实例" Style="{StaticResource Style.SectionTitle}" />

                        <ComboBox x:Name="InstanceBox"
                                  ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                  SelectionChanged="OnInstanceSelectionChanged"
                                  PlaceholderText="尚无实例 · 先去下载"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Padding="0,2">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource Brush.FgDim}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Command="{Binding LaunchCommand}"
                                Style="{StaticResource Style.LaunchButton}"
                                Height="76">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="9"
                                        Background="#2EFFFFFF"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;"
                                              FontSize="18"
                                              Foreground="{ThemeResource Brush.AccentFg}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="启动 Minecraft"
                                               FontSize="17.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource Brush.AccentFg}" />
                                    <TextBlock Text="{Binding LaunchHint}"
                                               FontSize="11.5"
                                               Opacity="0.82"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.AccentFg}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Foreground="{ThemeResource Brush.Accent}"
                                     Background="{ThemeResource Brush.AccentSoft}"
                                     Visibility="{Binding ProgressVisibility}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="13"
                                      Foreground="{ThemeResource Brush.FgFaint}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontSize="11.5"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding InstanceSummary}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       MaxWidth="360"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{ThemeResource Brush.Border}" />

                    <Border Grid.Column="2"
                            Background="{ThemeResource Brush.PanelGlass}"
                            CornerRadius="0,17,17,0"
                            Padding="24">
                        <StackPanel Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="账户" Style="{StaticResource Style.SectionTitle}" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="{ThemeResource Brush.AccentSoft}">
                                    <FontIcon Glyph="{Binding AccountGlyph}"
                                              FontSize="22"
                                              Foreground="{ThemeResource Brush.Accent}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding AccountName}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AccountDetail}"
                                               FontSize="11"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding OpenAccountCommand}"
                                    Style="{StaticResource Style.Ghost}"
                                    Foreground="{ThemeResource Brush.Accent}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="管理账户"
                                               FontSize="12"
                                               Foreground="{ThemeResource Brush.Accent}" />
                                    <FontIcon Glyph="&#xE76C;"
                                              FontSize="10"
                                              Foreground="{ThemeResource Brush.Accent}"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </Grid>

            <!-- Quick entries -->
            <StackPanel Grid.Row="2" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="3"
                            Height="12"
                            CornerRadius="1.5"
                            Background="{ThemeResource Brush.Accent}" />
                    <TextBlock Text="快捷入口" Style="{StaticResource Style.SectionTitle}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding OpenDownloadCommand}" Style="{StaticResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;"
                                          FontSize="16"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="下载游戏" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="安装新版本与补全文件"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding OpenMultiplayerCommand}"
                            Style="{StaticResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE709;"
                                          FontSize="16"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="联机" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="使用 Campfire 与好友联机"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding OpenDiagCommand}"
                            Style="{StaticResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="16"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="崩溃诊断" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="游戏崩溃时自动分析日志"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>

                    <Button Grid.Column="3"
                            Command="{Binding OpenLogsCommand}"
                            Style="{StaticResource Style.Tile}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource Brush.AccentSoft}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontSize="16"
                                          Foreground="{ThemeResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="应用日志" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="查看启动器运行记录"
                                           FontSize="11"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- First-run guide -->
            <StackPanel Grid.Row="3" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="3"
                            Height="12"
                            CornerRadius="1.5"
                            Background="{ThemeResource Brush.Accent}" />
                    <TextBlock Text="上手指南" Style="{StaticResource Style.SectionTitle}" />
                </StackPanel>
                <Border Style="{StaticResource Style.Card}" Padding="20,16">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{ThemeResource Brush.AccentSoft}">
                                    <TextBlock Text="1"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="安装版本"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="前往「资源 → 游戏版本」挑选并安装一个实例。"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{ThemeResource Brush.AccentSoft}">
                                    <TextBlock Text="2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="设置账户"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="正版登录或添加离线账户,随时切换。"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{ThemeResource Brush.AccentSoft}">
                                    <TextBlock Text="3"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="开始游戏"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="回到本页选择实例,点击启动即可。"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource Brush.FgDim}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
