<Page
    x:Class="SL.App.Pages.InstanceFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <Grid Margin="36,28,36,32" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleText"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="InstanceBox" MinWidth="160" SelectionChanged="OnInstanceChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="BackupButton"
                            Content="备份全部"
                            Click="OnBackup"
                            Visibility="Collapsed" />
                    <Button x:Name="RestoreButton"
                            Content="还原备份"
                            Click="OnRestoreBackup"
                            Visibility="Collapsed" />
                    <Button Content="刷新" Click="OnRefresh" />
                    <Button Content="打开目录" Click="OnOpenDir" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    MinHeight="240"
                    MaxHeight="760">
                <ListView x:Name="FileList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{ThemeResource Brush.AccentSoft}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="15"
                                              Foreground="{ThemeResource Brush.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="{Binding ActionText}"
                                        Tag="{Binding}"
                                        Click="OnRowAction"
                                        Visibility="{Binding ActionVisibility}"
                                        Padding="12,4"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
