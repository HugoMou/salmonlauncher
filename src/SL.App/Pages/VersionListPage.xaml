<Page
    x:Class="SL.App.Pages.VersionListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <Grid Margin="36,28,36,32" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="游戏版本"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Content="刷新清单" />
                    <Button Command="{Binding ChooseCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="下一步" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="搜索版本号(如 1.21)"
                             MinWidth="180"
                             TextChanged="OnSearchChanged"
                             VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Style="{StaticResource Style.SegmentHost}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="TypeAll"
                                         GroupName="VersionType"
                                         Content="全部"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnTypeChecked" />
                            <RadioButton x:Name="TypeRelease"
                                         GroupName="VersionType"
                                         Content="稳定版"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnTypeChecked" />
                            <RadioButton x:Name="TypeSnapshot"
                                         GroupName="VersionType"
                                         Content="快照"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnTypeChecked" />
                            <RadioButton x:Name="TypeAncient"
                                         GroupName="VersionType"
                                         Content="远古版本"
                                         Style="{StaticResource Style.Segment}"
                                         Checked="OnTypeChecked" />
                        </StackPanel>
                    </Border>
                    <ProgressRing Grid.Column="2"
                                  IsActive="True"
                                  Width="18"
                                  Height="18"
                                  Visibility="{Binding BusyVisibility}"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    MinHeight="220"
                    MaxHeight="760">
                <ListView ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{ThemeResource Brush.AccentSoft}"
                                        CornerRadius="6"
                                        Padding="7,1"
                                        Visibility="{Binding BadgeVisibility}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource Brush.Accent}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Released}"
                                           FontSize="11.5"
                                           Width="92"
                                           TextAlignment="Right"
                                           Foreground="{ThemeResource Brush.FgFaint}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
