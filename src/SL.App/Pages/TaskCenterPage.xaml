<Page
    x:Class="SL.App.Pages.TaskCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Root" Margin="36,28,36,32" Spacing="16" MaxWidth="960" HorizontalAlignment="Left">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="任务中心"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Text="{Binding Summary}"
                               FontSize="12"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Command="{Binding PauseAllCommand}" Content="全部暂停" />
                    <Button Command="{Binding ResumeAllCommand}" Content="全部继续" />
                    <Button Command="{Binding ClearFinishedCommand}" Content="清除已完成" />
                </StackPanel>
            </Grid>

            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="30"
                    Visibility="{Binding EmptyVisibility}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE823;"
                              FontSize="28"
                              Foreground="{ThemeResource Brush.FgFaint}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="暂无任务"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.FgDim}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="安装游戏或下载模组后,进度会显示在这里。"
                               FontSize="12"
                               Foreground="{ThemeResource Brush.FgFaint}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource Brush.Card}"
                                BorderBrush="{ThemeResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,14"
                                Margin="0,0,0,10">
                            <StackPanel Spacing="10">

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource Brush.Fg}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="{ThemeResource Brush.SuccessSoft}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                Visibility="{Binding RunBadgeVisibility}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RunBadge}"
                                                       FontSize="10.5"
                                                       Foreground="{ThemeResource Brush.Success}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StateText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ProgressBar Maximum="1"
                                             Value="{Binding Progress}"
                                             IsIndeterminate="{Binding IsIndeterminate}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="14"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource Brush.FgDim}" />
                                        <TextBlock Text="{Binding SpeedText}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource Brush.Accent}" />
                                        <TextBlock Text="{Binding RemainText}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource Brush.FgFaint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding PauseCommand}" Content="暂停" Padding="12,4"
                                                Visibility="{Binding PauseVisibility}" />
                                        <Button Command="{Binding ResumeCommand}" Content="继续" Padding="12,4"
                                                Visibility="{Binding ResumeVisibility}" />
                                        <Button Command="{Binding RetryCommand}" Content="重试" Padding="12,4"
                                                Visibility="{Binding RetryVisibility}" />
                                        <Button Command="{Binding CancelCommand}" Content="取消" Padding="12,4"
                                                Visibility="{Binding CancelVisibility}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ErrorText}"
                                           FontSize="11.5"
                                           Visibility="{Binding ErrorVisibility}"
                                           Foreground="{ThemeResource Brush.Danger}"
                                           TextWrapping="Wrap" />

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>