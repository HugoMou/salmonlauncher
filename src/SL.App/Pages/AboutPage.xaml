<Page
    x:Class="SL.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Margin="36,28,36,32" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="关于"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Foreground="{ThemeResource Brush.Fg}" />

            <!-- Brand card -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="60" Height="60" CornerRadius="15" Background="{ThemeResource Brush.AccentSoft}">
                            <Image Source="ms-appx:///Assets/Logo.png"
                                   Width="48"
                                   Height="48"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="SalmonLauncher"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource Brush.Fg}" />
                            <TextBlock x:Name="VersionText"
                                       FontSize="12"
                                       Foreground="{ThemeResource Brush.FgDim}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="一个把「装得上、启动得了、出问题查得到」做扎实的 Minecraft 启动器:官方元数据直连、逐文件校验、正版与离线账户并存、模组与光影一键安装、崩溃诊断与日志检索内置。"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Foreground="{ThemeResource Brush.FgDim}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnOpenRoot">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="打开数据目录" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnOpenLogs">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnOpenTerms">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="用户协议" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton NavigateUri="https://sl.hugomou.com/"
                                         Content="官方主站"
                                         Style="{StaticResource Style.Link}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Runtime info -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="运行信息" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <Grid ColumnSpacing="18" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="版本" Foreground="{ThemeResource Brush.FgFaint}" FontSize="12.5" />
                        <TextBlock x:Name="VersionRowText" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />

                        <TextBlock Grid.Row="1" Text="运行环境" Foreground="{ThemeResource Brush.FgFaint}" FontSize="12.5" />
                        <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />

                        <TextBlock Grid.Row="2" Text="数据目录" Foreground="{ThemeResource Brush.FgFaint}" FontSize="12.5" />
                        <TextBlock x:Name="RootText" Grid.Row="2" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />

                        <TextBlock Grid.Row="3" Text="协议状态" Foreground="{ThemeResource Brush.FgFaint}" FontSize="12.5" />
                        <TextBlock x:Name="TermsStateText" Grid.Row="3" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Brush.FgDim}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System requirements -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="系统要求" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 系统:Windows 10 版本 2004(内部版本 19041)或更高,Windows 11 亦可" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 架构:x64;暂不提供 ARM64 与 32 位版本" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 运行时:界面框架随软件自带,无需另行安装 .NET 或 Windows App SDK" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 内存:启动器实测约 150–200 MB;游戏建议分配 4 GB 以上" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 磁盘:程序目录约 150 MB(含随附的 Campfire),每个游戏实例另需 300 MB 起" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 网络:首次安装需要联网下载游戏文件与 Java 运行时" />
                </StackPanel>
            </Border>

            <!-- Data and privacy -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="数据与隐私" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 所有设置、账户令牌、日志、实例、存档与壁纸都保存在上面的数据目录里,不会上传到任何服务器。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 不含统计、埋点与广告组件,不收集设备信息、游戏行为或个人信息。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 卸载软件不会自动删除数据目录;需要清理时可在「外观与设置」页底部的「清除全部数据」中选择范围。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 迁移到新电脑时,复制整个数据目录即可带走全部设置与实例。" />
                </StackPanel>
            </Border>

            <!-- Install and uninstall -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="安装与卸载" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 安装:解压到任意目录后双击 SL.exe 即可运行,无需安装程序。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 升级:用新版本覆盖旧的程序文件,数据目录与实例不受影响。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 卸载:先退出启动器,再删除程序目录;如需彻底清理,再删除上面的数据目录。" />
                </StackPanel>
            </Border>

            <!-- Capabilities at a glance -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="能做些什么" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <Grid ColumnSpacing="20" RowSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Style="{ThemeResource Style.TermsBody}" Text="· 版本安装:官方清单、多源回退、断点续传与完整性校验" />
                        <TextBlock Grid.Column="1" Style="{ThemeResource Style.TermsBody}" Text="· 实例隔离:每个版本独立的模组、存档、日志与配置" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{ThemeResource Style.TermsBody}" Text="· 内容仓库:模组 / 光影 / 资源包检索并安装到对应实例" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{ThemeResource Style.TermsBody}" Text="· 账户:微软正版三种登录方式 + 无限量离线账户切换" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{ThemeResource Style.TermsBody}" Text="· 联机:随包分发 Campfire,一键启动并支持在线更新" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{ThemeResource Style.TermsBody}" Text="· 排障:崩溃诊断建议、日志检索与主题工坊换肤" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Feedback and issue reporting -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="遇到问题时" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 游戏崩溃:先到「系统 → 崩溃诊断」查看结论,再附上实例 logs/latest.log 的尾部。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 启动器异常:打开日志目录,附上最近的日志与出错前的操作步骤。" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· 反馈问题时请注明版本号与系统版本;请勿在公开渠道粘贴账户令牌。" />
                </StackPanel>
            </Border>

            <!-- Credits -->
            <Border Background="{ThemeResource Brush.Card}"
                    BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="致谢" FontWeight="SemiBold" Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· Mojang Studios:版本清单与资源元数据" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· BMCLAPI:官方源不可达时的镜像回退" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· Modrinth:模组、光影与资源包检索" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· Eclipse Temurin:按需获取的 Java 运行时" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· Windows App SDK:界面框架与窗口合成" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="· Campfire(GPL-3.0):联机功能,随安装包分发其未修改的官方发行版" />
                    <TextBlock Style="{ThemeResource Style.TermsBody}" Text="第三方组件的版本、校验值与源码获取方式见程序目录下的 THIRD-PARTY-NOTICES.md 与 campfire/SOURCE-OFFER.txt。" />
                </StackPanel>
            </Border>

            <TextBlock Text="SalmonLauncher 为第三方免费工具,与 Mojang Studios、Microsoft 无隶属或授权关系;Minecraft 是 Mojang Studios 的商标。"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource Brush.FgFaint}"
                       Margin="0,4,0,0" />
            <TextBlock Text="Copyright (C) 2026 Hugo Mou · SalmonLauncher 以 GNU GPL v3 或更新版本许可发布;源代码与许可证全文见项目仓库。"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource Brush.FgFaint}" />
        </StackPanel>
    </ScrollViewer>
</Page>