<UserControl
    x:Class="SL.App.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:SL.App.Themes">

    <Grid>
        <!--
          This view is laid over the whole window including the title bar (MainWindow gives it
          RowSpan=2), so it must not reserve a second band for the title bar: doing that pushed
          the header down and left a blank strip above the wordmark. The drag area is kept clear
          with padding instead, which does not create an empty row.
        -->
        <Border Background="{ThemeResource Brush.PageBg}">
            <!-- Soft accent wash behind the wizard so first launch does not look like a blank form -->
            <Grid>
                <Border IsHitTestVisible="False" Opacity="0.55">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource AccentBandStart}" />
                            <GradientStop Offset="0.55" Color="{ThemeResource AccentBandEnd}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled">
                <StackPanel MaxWidth="760"
                            Margin="60,60,60,84"
                            HorizontalAlignment="Center"
                            Spacing="14">

                    <!-- Header -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Border Width="52"
                                Height="52"
                                CornerRadius="15"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource Brush.AccentSoft}">
                            <Image Source="ms-appx:///Assets/Logo.png"
                                   Width="36"
                                   Height="36"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="欢迎使用 SalmonLauncher"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource Brush.Fg}"
                                   TextAlignment="Center" />
                        <TextBlock Text="几步简单设置就可以开始游戏"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource Brush.FgDim}"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Step indicator: five dots (ticked when finished) + progress bar below -->
                    <StackPanel Spacing="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending0" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent0" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone0" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum0" Text="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick0" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel0" Text="语言" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending1" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent1" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone1" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum1" Text="2" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick1" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel1" Text="条款" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending2" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent2" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone2" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum2" Text="3" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick2" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel2" Text="迁移" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending3" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent3" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone3" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum3" Text="4" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick3" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel3" Text="账户" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Spacing="5" HorizontalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Ellipse x:Name="DotPending4" Width="32" Height="32" Fill="{ThemeResource Brush.PanelBg}" Stroke="{ThemeResource Brush.Border}" StrokeThickness="2" />
                                    <Ellipse x:Name="DotCurrent4" Width="32" Height="32" Fill="Transparent" Stroke="{ThemeResource Brush.Accent}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="DotDone4" Width="32" Height="32" Fill="{ThemeResource Brush.Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DotNum4" Text="5" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource Brush.FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="DotTick4" Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource Brush.AccentFg}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DotLabel4" Text="主题" FontSize="11" Foreground="{ThemeResource Brush.FgFaint}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="StepBar" Minimum="0" Maximum="5" Value="0" Height="6" />
                        <TextBlock x:Name="ProgressText"
                                   Text="已完成 0/5"
                                   FontSize="11"
                                   Foreground="{ThemeResource Brush.FgFaint}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Step content -->
                    <Border Background="{ThemeResource Brush.Card}"
                            BorderBrush="{ThemeResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="26,22">
                        <Grid x:Name="Panels" MinHeight="300">

                            <!-- Page 1: Choose language -->
                            <StackPanel x:Name="PanelLang" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="选择语言"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="选择启动器的界面语言,选择后立即生效;之后可随时在「外观与设置」中更改。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="LangList" Spacing="8" />
                            </StackPanel>

                            <!-- Page 2: Accept the terms -->
                            <StackPanel x:Name="PanelTerms" Spacing="12" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="用户协议与免责声明"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="请阅读并同意以下条款后再继续。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="196"
                                              Background="{ThemeResource Brush.PageBg}"
                                              BorderBrush="{ThemeResource Brush.Border}"
                                              BorderThickness="1"
                                              CornerRadius="10">
                                    <StackPanel Spacing="10" Padding="15,12">
                                        <TextBlock Style="{StaticResource Style.TermsBody}"
                                                   Text="SalmonLauncher 为第三方免费工具,与 Mojang Studios、Microsoft 无隶属或授权关系;Minecraft 是 Mojang Studios 的商标。" />
                                        <TextBlock Style="{StaticResource Style.TermsBody}"
                                                   Text="本软件不含任何统计、埋点或广告组件,不会收集你的设备信息、游戏行为或个人信息。仅在排查问题时,你主动分享的日志文件会被读取。" />
                                        <TextBlock x:Name="TermsVersionLine"
                                                   Style="{StaticResource Style.TermsBody}"
                                                   Text="版本" />
                                    </StackPanel>
                                </ScrollViewer>
                                <CheckBox x:Name="TermsCheck"
                                          Content="我已阅读并同意以上条款"
                                          Checked="OnTermsToggled"
                                          Unchecked="OnTermsToggled" />
                            </StackPanel>

                            <!-- Page 3: Migrate from an existing launcher (HMCL / MultiMC / Official) -->
                            <StackPanel x:Name="PanelMigrate" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="从旧启动器迁移"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="检测到你之前可能用其他启动器开过 Minecraft,SalmonLauncher 可以帮你把账户导入进来;这一步是可选的,随时可以跳过。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Background="{ThemeResource Brush.PageBg}"
                                        BorderBrush="{ThemeResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16">
                                    <StackPanel x:Name="MigrateList" Spacing="10" />
                                </Border>

                                <TextBlock x:Name="MigrateHint"
                                           Text="如果检测不到旧启动器,可以跳过这一步,直接开始使用 SalmonLauncher。"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource Brush.FgFaint}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Page 4: Sign in with a premium account or create an offline account -->
                            <StackPanel x:Name="PanelAccount" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="登录账户"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="登录正版账号,或创建一个离线账号;两种账户都可随时在设置里切换。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="AccountRoot" Orientation="Horizontal" Spacing="14">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="{ThemeResource Brush.AccentSoft}">
                                        <FontIcon Glyph="{Binding ActiveGlyph}"
                                                  FontSize="22"
                                                  Foreground="{ThemeResource Brush.Accent}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource Brush.Fg}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11.5"
                                                   Foreground="{ThemeResource Brush.FgDim}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Command="{Binding LoginPremiumCommand}" Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                                            <TextBlock Text="正版授权登录" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddOfflineCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Text="添加离线账户" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="AccountHint"
                                           Text="还没有账户:登录正版或创建离线账户后才能继续。"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource Brush.Warning}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Page 4: Choose a theme (Theme Workshop · skippable) -->
                            <StackPanel x:Name="PanelTheme" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="选择主题"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource Brush.Fg}" />
                                    <TextBlock Text="用 Minecraft 风格的游戏画面做壁纸,配色自动从画面里取,连同背景一起应用成整套主题;本页可以跳过,之后随时能在「主题工坊」里换。"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource Brush.FgDim}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThemeStatusText"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnThemePickImage">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE722;" FontSize="13" />
                                                <TextBlock Text="选择图片" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnThemeClear">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="清除壁纸" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="内置场景" FontSize="12" Foreground="{ThemeResource Brush.FgDim}" Margin="0,2,0,-8" />

                                <GridView x:Name="ThemeSceneGrid"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="OnThemeSceneClick"
                                          Padding="0"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.IsHorizontalRailEnabled="True"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="themes:WallpaperCard">
                                            <Border Background="{ThemeResource Brush.Card}"
                                                    BorderBrush="{ThemeResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="7"
                                                    Width="148">
                                                <StackPanel Spacing="6">
                                                    <Border CornerRadius="7"
                                                            Height="80"
                                                            Background="{ThemeResource Brush.PageBg}">
                                                        <Image Source="{x:Bind Thumb, Mode=OneWay}"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Width="10" Height="10" CornerRadius="5"
                                                                Background="{x:Bind Dot, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource Brush.Fg}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Hex, Mode=OneWay}"
                                                               FontSize="10.5"
                                                               Foreground="{ThemeResource Brush.FgFaint}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <TextBlock Text="点击任意一张场景即可套用壁纸与配色;也可以「选择图片」,配色会从图片里自动取。"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource Brush.FgFaint}" />
                            </StackPanel>

                            <!-- Completion page -->
                            <StackPanel x:Name="PanelDone"
                                        Spacing="14"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="76" Height="76" CornerRadius="38" Background="{ThemeResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;"
                                              FontSize="34"
                                              Foreground="{ThemeResource Brush.Accent}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="恭喜你完成所有设置了,你现在可以使用 SalmonLauncher 了"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Fg}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="520"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="语言、条款、账户与主题都已配置完成,现在可以开始使用了。"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource Brush.FgDim}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

                <!-- Bottom navigation: pinned outside the scroller so it is always reachable -->
                <Border VerticalAlignment="Bottom"
                        Background="{ThemeResource Brush.PageBg}"
                        BorderBrush="{ThemeResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="60,12">
                    <Grid MaxWidth="760" HorizontalAlignment="Center" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackBtn"
                                Content="上一步"
                                Click="OnBack"
                                MinWidth="96"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <HyperlinkButton x:Name="SkipBtn"
                                             Content="跳过"
                                             Click="OnNext"
                                             Visibility="Collapsed"
                                             MinWidth="56"
                                             VerticalAlignment="Center" />
                            <Button x:Name="NextBtn"
                                    Content="下一步"
                                    MinWidth="96"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnNext" />
                            <Button x:Name="StartBtn"
                                    Content="开始使用"
                                    MinWidth="110"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnStart"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
