<Application
    x:Class="SL.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 控件样式
             ============================================================ -->

            <!-- Segmented control: 横向排列的圆角按钮组；选中态使用强调色文本 + 卡片背景 -->
            <Style x:Key="Style.Segment" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="SegmentRoot"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}" />
                                <ContentPresenter x:Name="SegmentContent"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentRoot.Background" Value="{ThemeResource Brush.CardHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentRoot.Background" Value="{ThemeResource Brush.CardPress}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentContent.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="SegmentRoot.Background" Value="{ThemeResource Brush.Card}" />
                                                <Setter Target="SegmentContent.Foreground" Value="{ThemeResource Brush.Accent}" />
                                                <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 容器背景：分段式控件容器 -->
            <Style x:Key="Style.SegmentHost" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.PageBg}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- 文本链接按钮 -->
            <Style x:Key="Style.Link" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.Accent}" />
            </Style>

            <!-- 条款正文 -->
            <Style x:Key="Style.TermsBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
            </Style>

            <!-- 页面主标题 -->
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.Fg}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- 标准卡片：半透明卡片，使背景纹理仍然可见 -->
            <Style x:Key="Style.Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.CardGlass}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- 主卡片：带阴影层，用于主要操作面板 -->
            <Style x:Key="Style.HeroCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.CardGlass}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="28,24" />
            </Style>

            <!-- 徽章：用于版本/状态标签的小圆角标签 -->
            <Style x:Key="Style.Badge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.AccentSoft}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 嵌套/次级卡片 -->
            <Style x:Key="Style.SubCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.PanelGlass}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="Style.PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.Fg}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="Style.PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Style.SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>

            <!-- 快速入口卡片：带悬停/按下状态 -->
            <Style x:Key="Style.Tile" TargetType="Button">
                <Setter Property="MinHeight" Value="86" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="TileRoot"
                                        Background="{ThemeResource Brush.CardGlass}"
                                        BorderBrush="{ThemeResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}" />
                                <ContentPresenter x:Name="TileContent"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Padding="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TileRoot.Background" Value="{ThemeResource Brush.CardHover}" />
                                                <Setter Target="TileRoot.BorderBrush" Value="{ThemeResource Brush.Accent}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TileRoot.Background" Value="{ThemeResource Brush.CardPress}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="TileContent.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主启动动作：大号强调色背景，带柔和顶部高光 -->
            <Style x:Key="Style.LaunchButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.AccentFg}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="LaunchRoot"
                                        Background="{ThemeResource Brush.Accent}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1FFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="LaunchContent"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LaunchRoot.Background" Value="{ThemeResource Brush.AccentHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LaunchRoot.Background" Value="{ThemeResource Brush.AccentPress}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LaunchContent.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主启动按钮别名（页面统一使用 Style.LaunchCard） -->
            <Style x:Key="Style.LaunchCard" TargetType="Button" BasedOn="{StaticResource Style.LaunchButton}" />

            <!-- 标题字号 -->
            <x:Double x:Key="PageTitleSize">26</x:Double>

            <!-- ============================================================
                 欢迎页 / 引导页
             ============================================================ -->
            <Style x:Key="Style.WelcomeCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Brush.CardGlass}" />
                <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="48,44" />
                <Setter Property="MaxWidth" Value="880" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Style.WelcomeTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.Fg}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="Style.WelcomeSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Style.WelcomeStepTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.Fg}" />
            </Style>

            <Style x:Key="Style.WelcomeStepDesc" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.FgDim}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Style.WelcomeButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{ThemeResource Brush.AccentFg}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- 低亮度文本按钮 -->
            <Style x:Key="Style.Ghost" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="GhostRoot"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="GhostContent"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Padding="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="GhostRoot.Background" Value="{ThemeResource Brush.AccentSoft}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="GhostRoot.Background" Value="{ThemeResource Brush.CardPress}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="GhostContent.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
