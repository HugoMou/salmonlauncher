<ContentDialog
    x:Class="SL.App.Dialogs.WhatsNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="更新公告"
    PrimaryButtonText="知道了"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MinWidth="460">

            <Border Background="{ThemeResource Brush.AccentSoft}"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="HighlightsHost" Spacing="10" />

            <Border BorderBrush="{ThemeResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于数据"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource Brush.Fg}" />
                    <TextBlock Text="升级只会替换程序文件。设置、账户、实例、存档、日志与模组都保存在独立的数据目录中，不会因为更新被删除。"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource Brush.FgDim}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FootnoteText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource Brush.FgFaint}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
