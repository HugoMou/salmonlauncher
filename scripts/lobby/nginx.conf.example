# SalmonLauncher lobby — Nginx location block
#
# Paste this inside the `server { ... }` block that already serves the site, then
# `nginx -t && systemctl reload nginx`. The launcher talks to https://<host>/lobby/rooms.
#
# The trailing slash on proxy_pass is what strips the /lobby prefix before the
# request reaches the Node process.

location /lobby/ {
    proxy_pass http://127.0.0.1:8787/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 30s;
    client_max_body_size 32k;

    # JSON only, never cached
    add_header Cache-Control "no-store" always;
}
